# Database settings
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/pulseiq
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017/

# API Credentials (leave blank to use the built-in mock fallback data generators)
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PulseIQ/1.0

# Sentiment Model (True to use FinBERT, False for VADER)
USE_FINBERT=False

# Scheduler settings
PIPELINE_INTERVAL_MINUTES=5

# Security settings
API_KEY=pulseiq-dev-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000
